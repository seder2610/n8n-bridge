<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bridge_api_key_form" model="ir.ui.view">
        <field name="name">bridge.api.key.form</field>
        <field name="model">bridge.api.key</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_regenerate_key" type="object"
                            string="Regenerate key" class="btn-secondary"
                            confirm="Any integration still using the current key will stop working. Continue?"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="n8n — supplier follow-up workflow"/></h1>
                    </div>
                    <group>
                        <field name="user_id"/>
                        <field name="key" password="True"/>
                        <field name="last_used_at"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Send this value in the <code>X-Bridge-Key</code> header on
                        <code>POST /n8n_bridge/v1/act</code>. Calls run as the user above,
                        so its access rights are the real limit on what the integration can do.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bridge_api_key_list" model="ir.ui.view">
        <field name="name">bridge.api.key.list</field>
        <field name="model">bridge.api.key</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
                <field name="last_used_at"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_bridge_api_key" model="ir.actions.act_window">
        <field name="name">Inbound API Keys</field>
        <field name="res_model">bridge.api.key</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
