<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root menu — defined here because this file loads before
         webhook_subscription_views.xml, which hangs its own submenu off it. -->
    <menuitem id="menu_n8n_bridge_root" name="n8n Bridge" sequence="95"
              groups="n8n_bridge.group_n8n_bridge_manager"/>

    <record id="view_webhook_delivery_list" model="ir.ui.view">
        <field name="name">webhook.delivery.list</field>
        <field name="model">webhook.delivery</field>
        <field name="arch" type="xml">
            <tree decoration-danger="state == 'failed'" decoration-muted="state == 'sent'" create="0">
                <field name="create_date" string="Queued at"/>
                <field name="subscription_id"/>
                <field name="res_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'failed'"/>
                <field name="attempts"/>
                <field name="sent_at"/>
                <field name="last_error"/>
            </tree>
        </field>
    </record>

    <record id="view_webhook_delivery_form" model="ir.ui.view">
        <field name="name">webhook.delivery.form</field>
        <field name="model">webhook.delivery</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <field name="subscription_id"/>
                        <field name="res_id"/>
                        <field name="state"/>
                        <field name="attempts"/>
                        <field name="sent_at"/>
                    </group>
                    <group string="Payload">
                        <field name="payload" widget="text" nolabel="1"/>
                    </group>
                    <group string="Last error" invisible="not last_error">
                        <field name="last_error" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_webhook_delivery" model="ir.actions.act_window">
        <field name="name">Deliveries</field>
        <field name="res_model">webhook.delivery</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_webhook_delivery" name="Deliveries" parent="menu_n8n_bridge_root"
              action="action_webhook_delivery" sequence="20"/>

    <record id="ir_cron_send_pending_deliveries" model="ir.cron">
        <field name="name">n8n Bridge: send pending deliveries</field>
        <field name="model_id" ref="model_webhook_delivery"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_pending()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

</odoo>
