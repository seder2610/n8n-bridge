<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_webhook_subscription_form" model="ir.ui.view">
        <field name="name">webhook.subscription.form</field>
        <field name="model">webhook.subscription</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                        <button name="%(action_webhook_delivery)d" type="action" class="oe_stat_button" icon="fa-paper-plane">
                            <field name="delivery_count" widget="statinfo" string="Deliveries"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="model_name"/>
                        <field name="trigger"/>
                        <field name="state_field" invisible="trigger != 'state_change'"/>
                    </group>
                    <group string="Delivery">
                        <field name="target_url" placeholder="https://n8n.example.com/webhook/xxxxx"/>
                        <field name="secret" password="True"/>
                        <field name="timeout"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_webhook_subscription_list" model="ir.ui.view">
        <field name="name">webhook.subscription.list</field>
        <field name="model">webhook.subscription</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_name"/>
                <field name="trigger"/>
                <field name="target_url"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="action_webhook_subscription" model="ir.actions.act_window">
        <field name="name">Webhook Subscriptions</field>
        <field name="res_model">webhook.subscription</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Root menu (menu_n8n_bridge_root) is defined in webhook_delivery_views.xml,
         which loads first. -->
    <menuitem id="menu_webhook_subscription" name="Subscriptions" parent="menu_n8n_bridge_root"
              action="action_webhook_subscription" sequence="10"/>

</odoo>
